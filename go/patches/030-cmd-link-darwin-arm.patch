+func machoreloc1(arch *sys.Arch, out *ld.OutBuf, ldr *loader.Loader, s loader.Sym, r loader.ExtReloc, sectoff int64) bool {
+	// Revived darwin/arm port: ported from the Go 1.14 implementation
+	// (cmd/link/internal/arm/asm.go), which ran on exactly this OS/arch.
+	// Uses the modern ExtReloc signature like arm64's machoreloc1.
+	var v uint32
+
+	rs := r.Xsym
+	rt := r.Type
+	siz := r.Size
+
+	if rt == objabi.R_PCREL {
+		// emit a pair of "scattered" relocations that resolve to the
+		// difference of section addresses of the symbol and the
+		// instruction (used for DWARF section diffs).
+		if ldr.SymType(rs).IsText() || ldr.SymType(rs).IsDWARF() {
+			// 1.14 only ever saw non-text here; keep the pair form.
+		}
+		o1 := uint32(sectoff)
+		o1 |= 1 << 31 // scattered bit
+		o1 |= ld.MACHO_ARM_RELOC_SECTDIFF << 24
+		o1 |= 2 << 28 // size = 4
+		o2 := uint32(0)
+		o2 |= 1 << 31 // scattered bit
+		o2 |= ld.MACHO_ARM_RELOC_PAIR << 24
+		o2 |= 2 << 28 // size = 4
+		out.Write32(o1)
+		out.Write32(uint32(ldr.SymAddr(rs)))
+		out.Write32(o2)
+		out.Write32(uint32(ldr.SymValue(s) + sectoff))
+		return true
+	}
+
+	if ldr.SymType(rs) == sym.SHOSTOBJ || rt == objabi.R_CALLARM {
+		if ldr.SymDynid(rs) < 0 {
+			ldr.Errorf(s, "reloc %d (%s) to non-macho symbol %s type=%d (%s)",
+				rt, sym.RelocName(arch, rt), ldr.SymName(rs), ldr.SymType(rs), ldr.SymType(rs))
+			return false
+		}
+		v = uint32(ldr.SymDynid(rs))
+		v |= 1 << 27 // external relocation
+	} else {
+		v = uint32(ldr.SymSect(rs).Extnum)
+		if v == 0 {
+			ldr.Errorf(s, "reloc %d (%s) to symbol %s in non-macho section %s type=%d (%s)",
+				rt, sym.RelocName(arch, rt), ldr.SymName(rs), ldr.SymSect(rs).Name, ldr.SymType(rs), ldr.SymType(rs))
+			return false
+		}
+	}
+
+	switch rt {
+	default:
+		return false
+	case objabi.R_ADDR:
+		v |= ld.MACHO_GENERIC_RELOC_VANILLA << 28
+	case objabi.R_CALLARM:
+		v |= 1 << 24 // pc-relative bit
+		v |= ld.MACHO_ARM_RELOC_BR24 << 28
+	}
+
+	switch siz {
+	default:
+		return false
+	case 1:
+		v |= 0 << 25
+	case 2:
+		v |= 1 << 25
+	case 4:
+		v |= 2 << 25
+	case 8:
+		v |= 3 << 25
+	}
+
+	out.Write32(uint32(sectoff))
+	out.Write32(v)
+	return true
 }
 
