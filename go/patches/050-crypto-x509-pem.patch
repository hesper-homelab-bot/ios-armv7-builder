diff -ruN old/src/crypto/x509/root_darwin_arm.go new/src/crypto/x509/root_darwin_arm.go
--- old/src/crypto/x509/root_darwin_arm.go	1970-01-01 08:00:00.000000000 +0800
+++ new/src/crypto/x509/root_darwin_arm.go	2026-11-17 15:55:22.742202702 +0800
@@ -0,0 +1,31 @@
+// Copyright 2012 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build darwin && arm
+
+package x509
+
+import "errors"
+
+// darwin/arm (revived port, Go 1.27.2): upstream root_darwin.go provides
+// empty certFiles and a CoreFoundation/Security systemVerify, neither of
+// which works on iOS (macOS-style /Versions/A framework paths, no
+// SecTrustSettings). This port loads PEM bundles from disk instead — the
+// device is provisioned with /etc/ssl/cert.pem (see ts-ios BUILD-NOTES §4),
+// and root.go's darwin branch is patched to take the on-disk path here.
+//
+// systemVerify is never reached with an on-disk (non-system) root pool;
+// if it ever is, fall back to the Go verifier by failing here.
+
+var certFiles = []string{
+	"/etc/ssl/cert.pem",
+	"/var/root/ts/roots.pem",
+	"/var/mobile/ts/roots.pem",
+}
+
+var certDirectories []string
+
+func (c *Certificate) systemVerify(opts *VerifyOptions) (chains [][]*Certificate, err error) {
+	return nil, errors.New("crypto/x509: system verifier not available on darwin/arm")
+}
