@@ -106,6 +106,12 @@
 	MOVW	R0, 60(R13)		// save argc, argv away
 	MOVW	R1, 64(R13)
 
+#ifdef GOOS_darwin
+	// darwin/arm (revived port): no cgo, no pthread TSD.  The per-thread
+	// g slot is registered by save_g itself on the first setg: it keys an
+	// entry of runtime.tlsSlotTab by this thread's TPIDRURO (see
+	// tls_arm.s, TLSG_IS_SLOT_TAB).  Nothing to initialise here.
