+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build darwin && arm
+
+package runtime
+
+// preemptMSupported is false on darwin/arm (revived port, 2026-11-18):
+// async preemption SIGURGs land in libc contexts where runtime.sigtramp's
+// load_g cannot recover the g — the TLS g-slot is not initialized on iOS 10
+// (pthread_key_create succeeds but the key write is bypassed, see
+// sys_darwin_arm.s) — and the receiving thread hangs.  Without this, every
+// Go program needs GODEBUG=asyncpreemptoff=1.  Cooperative preemption via
+// gp.stackguard0 (set in preemptone) still works; only the async SIGURG
+// path is skipped.
+const preemptMSupported = false
