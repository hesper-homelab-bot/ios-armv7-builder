+// syscallN_trampoline: dynamic-arity libc call for syscall.syscalln.
+// Go-side struct (32-bit slots): fn@0, n@4, args@8, r1@12, r2@16.
+// arm32 AAPCS: args 1-4 in R0-R3, args 5+ on the stack.
+// Variadic quirk (mirrors the arm64 trampoline): open/fcntl/ioctl
+// (n==3) and openat (n==4, legacy n==6) take their variadic part on
+// the stack, so an extra word is pushed for those arities.  Extra
+// stack words are harmless for fixed-arity libc calls, which never
+// route through this trampoline beyond what the quirk covers.
+TEXT runtime·syscallN_trampoline(SB),NOSPLIT,$0
+	MOVW	R0, R4		// R4 = &info (libc preserves r4-r11)
+	MOVW	R13, R5		// R5 = entry SP (restore after call)
+	MOVW	8(R4), R8	// R8 = &args[0]
+	MOVW	4(R4), R7	// R7 = n
+
+	// R0-R3 = args[0..3] (loads beyond n are skipped)
+	CMP	$0, R7
+	BEQ	regsdone
+	MOVW	0(R8), R0
+	CMP	$1, R7
+	BEQ	regsdone
+	MOVW	4(R8), R1
+	CMP	$2, R7
+	BEQ	regsdone
+	MOVW	8(R8), R2
+	CMP	$3, R7
+	BEQ	regsdone
+	MOVW	12(R8), R3
+regsdone:
+
+	// Words to reserve on the stack:
+	//   base = max(0, n-4)            (args[4..] for fixed-arity calls)
+	//   +1 for the vararg quirk when n==3, n==4 or n==6
+	//   padded to an even number of words (8-byte alignment)
+	MOVW	$0, R6		// slots
+	CMP	$4, R7
+	BLE	noledger
+	SUB	$4, R7, R6	// slots = n-4
+noledger:
+	CMP	$3, R7
+	BEQ	quirk
+	CMP	$4, R7
+	BEQ	quirk
+	B	noquirk
+quirk:
+	ADD	$1, R6
+noquirk:
+	// round slots up to even
+	// round slots up to an even number of words, convert to bytes
+	ADD	$1, R6
+	BIC	$1, R6
+	ADD	R6, R6
+	ADD	R6, R6		// slots*4 (BUGFIX 2026-11-18: was a single ADD = ×2,
+				// reserving half the needed space; the argument
+				// mainloop then wrote args[5] straight over the
+				// pushed return address — canary #0/#1 pinned it:
+				// slot [R5] read 0xe = args[5] with R9=0x8bdfc
+				// intact, before any libc code ran)
+	SUB	R6, R13		// reserve; R13 stays 8-aligned
+
+	// fill the reservation
+	CMP	$3, R7
+	BEQ	st_3
+	CMP	$4, R7
+	BEQ	st_4
+	// main block: slots = n-4 words of args[4..], stored forward
+	MOVW	R8, R12
+	ADD	$16, R12	// src = &args[4]
+	MOVW	R13, R11	// dst base
+	SUB	$4, R7		// count = n-4
+	CMP	$0, R7
+	BLE	callit		// BUGFIX 2026-11-18: n<=4 pushes no stack words.
+				// The arm64 original guards this with the
+				// _0args.._8args BEQ chain; the arm32 rewrite
+				// lost that guard, so count went negative and
+				// the copy loop stored forever (live-frozen on
+				// the first n<=4 syscalln call after the ×4 fix).
+mainloop:
+	MOVW	0(R12), R6
+	MOVW	R6, 0(R11)
+	ADD	$4, R12
+	ADD	$4, R11
+	SUB	$1, R7
+	CMP	$0, R7
+	BNE	mainloop
+	B	callit
+st_3:	// open/fcntl/ioctl: variadic part (args[2]) on the stack
+	MOVW	8(R8), R6
+	MOVW	R6, 0(R13)
+	B	callit
+st_4:	// openat: variadic part (args[3]) on the stack
+	MOVW	12(R8), R6
+	MOVW	R6, 0(R13)
+	B	callit
+callit:
+	MOVW	0(R4), R12	// fn
+	BL	(R12)
+	MOVW	R5, R13		// release the reservation
+	MOVW	R0, 12(R4)	// info->r1
+	MOVW	R1, 16(R4)	// info->r2
+	BL	libc_error(SB)
+	MOVW	(R0), R0	// errno
+	RET
+
+// syscall_x509 is for crypto/x509: like syscall6 but without error
+// checking; 5 uintptrs and 1 float64, single return value.
+// Go-side struct (arm32 slots): fn@0, a1@4, a2@8, a3@12, a4@16, a5@20,
+// f1@24 (two 32-bit words: lo@24, hi@28), r1@32.
+// AAPCS-VFP: a1-a4 in R0-R3, a5 on the stack, the double in d0
+// (= {s0,s1} on VFPv3).
+TEXT runtime·syscall_x509(SB),NOSPLIT,$0
+	MOVW	R0, R4		// &args
+	MOVW	20(R4), R6	// a5
+	MOVW.W	R6, -8(R13)	// push a5 + pad (8-align)
+	MOVW	28(R4), R7	// f1 high word
+	MOVW	24(R4), R6	// f1 low word
+	MOVW	R6, F0		// s0 = lo
+	MOVW	R7, F1		// s1 = hi  -> d0 = f1
+	MOVW	16(R4), R3	// a4
+	MOVW	12(R4), R2	// a3
+	MOVW	8(R4), R1	// a2
+	MOVW	4(R4), R0	// a1
+	MOVW	0(R4), R12	// fn
+	BL	(R12)
+	ADD	$8, R13		// pop a5 + pad
+	MOVW	R0, 32(R4)	// save r1
+	RET
+
+TEXT runtime·pthread_setspecific_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 value
+	MOVW	0(R0), R0	// arg 1 k (pthread key)
+	BL	libc_pthread_setspecific(SB)
+	RET
+TEXT runtime·sigfwd(SB),NOSPLIT,$0-16
+	MOVW	sig+4(FP), R0
+	MOVW	info+8(FP), R1
+	MOVW	ctx+12(FP), R2
+	MOVW	fn+0(FP), R11
+	MOVW	R13, R4
+	SUB	$24, R13
+	BIC	$0x7, R13 // alignment for ELF ABI
+	BL	(R11)
+	MOVW	R4, R13
+	RET
+
