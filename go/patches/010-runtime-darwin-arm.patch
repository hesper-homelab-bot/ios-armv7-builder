+// Copyright 2020 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"internal/abi"
+	"unsafe"
+)
+
+// libc function wrappers. Must run on system stack.
+
+//go:nosplit
+//go:cgo_unsafe_args
+func g0_pthread_key_create(k *pthreadkey, destructor uintptr) int32 {
+	ret := asmcgocall(unsafe.Pointer(abi.FuncPCABI0(pthread_key_create_trampoline)), unsafe.Pointer(&k))
+	KeepAlive(k)
+	return ret
+}
+func pthread_key_create_trampoline()
+
+//go:nosplit
+//go:cgo_unsafe_args
+func g0_pthread_setspecific(k pthreadkey, value uintptr) int32 {
+	return asmcgocall(unsafe.Pointer(abi.FuncPCABI0(pthread_setspecific_trampoline)), unsafe.Pointer(&k))
+}
+func pthread_setspecific_trampoline()
+
+//go:cgo_import_dynamic libc_pthread_key_create pthread_key_create "/usr/lib/libSystem.B.dylib"
+//go:cgo_import_dynamic libc_pthread_setspecific pthread_setspecific "/usr/lib/libSystem.B.dylib"
+// NOTE (darwin/arm revived port): there is deliberately no tlsinit here.
+//
+// Go 1.14 allocated the g slot with pthread_key_create + a TPIDRURO slot
+// scan (runtime/cgo/gcc_darwin_arm.c).  On iOS 10.3.3 that does not work
+// for a pure-Go internal link: pthread_key_create returns success while
+// leaving *key untouched (probed 2026-11-17: err == 0, key read back as 0),
+// so pthread_setspecific afterwards operates on key 0 and fails.
+//
+// Instead rt0_go publishes a fixed slot address in runtime.tls_g and
+// save_g/load_g read and write g through it (see TLSG_IS_ABSOLUTE_POINTER
+// in tls_arm.s).  See also the tls_g0slot global there.
diff -ruN old/src/runtime/sys_darwin_arm.s new/src/runtime/sys_darwin_arm.s
--- old/src/runtime/sys_darwin_arm.s	1970-01-01 08:00:00.000000000 +0800
+++ new/src/runtime/sys_darwin_arm.s	2026-11-19 09:07:40.848925557 +0800
@@ -0,0 +1,726 @@
+// Copyright 2014 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// System calls and other sys.stuff for ARM, Darwin
+// System calls are implemented in libSystem, this file contains
+// trampolines that convert from Go to C calling convention.
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "textflag.h"
+
+TEXT notok<>(SB),NOSPLIT,$0
+	MOVW	$0, R8
+	MOVW	R8, (R8)
+	B		0(PC)
+
+TEXT runtime·open_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 mode
+	MOVW	8(R0), R2	// arg 3 perm
+	MOVW	0(R0), R0	// arg 1 name
+	BL	libc_open(SB)
+	RET
+
+TEXT runtime·close_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 fd
+	BL	libc_close(SB)
+	RET
+
+TEXT runtime·write_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 buf
+	MOVW	8(R0), R2	// arg 3 count
+	MOVW	0(R0), R0	// arg 1 fd
+	BL	libc_write(SB)
+	MOVW	$-1, R1
+	CMP	R0, R1
+	BNE	noerr
+	BL	libc_error(SB)
+	MOVW	(R0), R0
+	RSB	$0, R0, R0	// caller expects negative errno value
+noerr:
+	RET
+
+TEXT runtime·read_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 buf
+	MOVW	8(R0), R2	// arg 3 count
+	MOVW	0(R0), R0	// arg 1 fd
+	BL	libc_read(SB)
+	MOVW	$-1, R1
+	CMP	R0, R1
+	BNE	noerr
+	BL	libc_error(SB)
+	MOVW	(R0), R0
+	RSB	$0, R0, R0	// caller expects negative errno value
+noerr:
+	RET
+
+TEXT runtime·pipe_trampoline(SB),NOSPLIT,$0
+	BL	libc_pipe(SB)	// pointer already in R0
+	CMP	$0, R0
+	BEQ	3(PC)
+	BL	libc_error(SB)	// return negative errno value
+	RSB	$0, R0, R0
+	RET
+
+TEXT runtime·exit_trampoline(SB),NOSPLIT|NOFRAME,$0
+	MOVW	0(R0), R0	// arg 0 code
+	BL libc_exit(SB)
+	MOVW	$1234, R0
+	MOVW	$1002, R1
+	MOVW	R0, (R1)	// fail hard
+
+TEXT runtime·raiseproc_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R8	// signal
+	BL	libc_getpid(SB)
+	// arg 1 pid already in R0 from getpid
+	MOVW	R8, R1	// arg 2 signal
+	BL	libc_kill(SB)
+	RET
+
+TEXT runtime·mmap_trampoline(SB),NOSPLIT,$0
+	MOVW	R0, R8
+	MOVW	0(R8), R0	// arg 1 addr
+	MOVW	4(R8), R1	// arg 2 len
+	MOVW	8(R8), R2	// arg 3 prot
+	MOVW	12(R8), R3	// arg 4 flags
+	MOVW	16(R8), R4	// arg 5 fid
+	MOVW	20(R8), R5	// arg 6 offset
+	MOVW	$0, R6	// off_t is uint64_t
+	// Only R0-R3 are used for arguments, the rest go on the stack, with
+	// arg 5 at the lowest address.  "MOVM.DB.W [R4-R6]" stored R6 first,
+	// i.e. in reverse, and moved SP by 12 leaving it misaligned; see
+	// sysctl_trampoline.  The prologue pushed LR (4 bytes), so the frame
+	// size must be 4 mod 8 to bring SP back to an 8-byte boundary: 20
+	// bytes = fd + 64-bit offset + the alignment fixup.  clang generates
+	// "strd r1,r0,[sp] / str r0,[sp,#8]" for the same call.
+	SUB	$20, R13
+	MOVW	R4, 0(R13)	// arg 5: fd
+	MOVW	R5, 4(R13)	// arg 6: offset low
+	MOVW	R6, 8(R13)	// arg 6: offset high
+	BL	libc_mmap(SB)
+	ADD	$20, R13
+	MOVW	$0, R1
+	MOVW	$-1, R2
+	CMP	R0, R2
+	BNE ok
+	BL	libc_error(SB)
+	MOVW	(R0), R1
+	MOVW	$0, R0
+ok:
+	MOVW	R0, 24(R8)	// ret 1 addr
+	MOVW	R1, 28(R8)	// ret 2 err
+	RET
+
+TEXT runtime·munmap_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 len
+	MOVW	0(R0), R0	// arg 1 addr
+	BL libc_munmap(SB)
+	MOVW	$-1, R2
+	CMP	R0, R2
+	BL.EQ	notok<>(SB)
+	RET
+
+TEXT runtime·madvise_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 len
+	MOVW	8(R0), R2	// arg 3 advice
+	MOVW	0(R0), R0	// arg 1 addr
+	BL	libc_madvise(SB)
+	MOVW	$-1, R2
+	CMP	R0, R2
+	BL.EQ	notok<>(SB)
+	RET
+
+TEXT runtime·setitimer_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 new
+	MOVW	8(R0), R2	// arg 3 old
+	MOVW	0(R0), R0	// arg 1 which
+	BL	libc_setitimer(SB)
+	RET
+
+TEXT runtime·walltime_trampoline(SB),NOSPLIT,$0
+	// R0 already has *timeval
+	MOVW	$0, R1 // no timezone needed
+	BL	libc_gettimeofday(SB)
+	RET
+
+// darwin/arm (revived port): the conversion factors are baked in rather
+// than queried with mach_timebase_info at first use.
+//
+// Calling mach_timebase_info from this trampoline crashed iOS 10.3.3
+// inside libSystem immediately after the call, even though the argument
+// pointer and the return address were both verified correct at the PLT
+// stub (2026-11-17).  A C probe on the same device reports the values
+// below, and they are a fixed property of the SoC, so hardcoding them is
+// both simpler and immune to that crash.
+//
+// Measured on the target: mach_timebase_info -> numer=125, denom=3.
+DATA	timebase<>+machTimebaseInfo_numer(SB)/4, $125
+DATA	timebase<>+machTimebaseInfo_denom(SB)/4, $3
+
+TEXT runtime·nanotime_trampoline(SB),NOSPLIT,$0
+	MOVW	R0, R8
+	BL	libc_mach_absolute_time(SB)
+	MOVW	R0, 0(R8)
+	MOVW	R1, 4(R8)
+	MOVW	$125, R6	// machTimebaseInfo_numer
+	MOVW	$3, R7		// machTimebaseInfo_denom
+	MOVW	R6, 8(R8)
+	MOVW	R7, 12(R8)
+	RET
+
+TEXT runtime·sigtramp(SB),NOSPLIT,$0
+	// Reserve space for callee-save registers and arguments.
+	MOVM.DB.W [R4-R11], (R13)
+	SUB	$16, R13
+
+	// Save arguments.
+	MOVW	R0, 4(R13)	// sig
+	MOVW	R1, 8(R13)	// info
+	MOVW	R2, 12(R13)	// ctx
+
+	// this might be called in external code context, where g is not set.
+	// BUGFIX 2026-11-19: load unconditionally.  The upstream check
+	// (iscgo != 0) assumed a cgo build; the revived pure-Go port has
+	// iscgo == 0, so the load was skipped and the interrupted context's
+	// garbage in g (R10 — often the TPIDRURO value) was dereferenced:
+	// g_m read at offset 0x28 faulted, hanging or killing the thread.
+	// The slot-table load_g is safe to run unconditionally.
+	BL	runtime·load_g(SB)
+
+	MOVW	R13, R6
+	CMP	$0, g
+	BEQ nog
+
+	// iOS always use the main stack to run the signal handler.
+	// We need to switch to gsignal ourselves.
+	MOVW	g_m(g), R11
+	MOVW	m_gsignal(R11), R5
+	MOVW	(g_stack+stack_hi)(R5), R6
+
+nog:
+	// Restore arguments.
+	MOVW	4(R13), R0
+	MOVW	8(R13), R1
+	MOVW	12(R13), R2
+
+	// Reserve space for args and the stack pointer on the
+	// gsignal stack.
+	SUB $24, R6
+	// Save stack pointer.
+	MOVW	R13, R4
+	MOVW	R4, 16(R6)
+	// Switch to gsignal stack.
+	MOVW	R6, R13
+
+	// Call sigtrampgo
+	MOVW	R0, 4(R13)
+	MOVW	R1, 8(R13)
+	MOVW	R2, 12(R13)
+	BL	runtime·sigtrampgo(SB)
+
+	// Switch to old stack.
+	MOVW	16(R13), R5
+	MOVW	R5, R13
+
+	// Restore callee-save registers.
+	ADD	$16, R13
+	MOVM.IA.W (R13), [R4-R11]
+
+	RET
+
+TEXT runtime·cgoSigtramp(SB),NOSPLIT,$0
+	JMP	runtime·sigtramp(SB)
+
+TEXT runtime·sigprocmask_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 new
+	MOVW	8(R0), R2	// arg 3 old
+	MOVW	0(R0), R0	// arg 1 how
+	BL	libc_pthread_sigmask(SB)
+	CMP	$0, R0
+	BL.NE	notok<>(SB)
+	RET
+
+TEXT runtime·sigaction_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 new
+	MOVW	8(R0), R2	// arg 3 old
+	MOVW	0(R0), R0	// arg 1 how
+	BL	libc_sigaction(SB)
+	RET
+
+TEXT runtime·usleep_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 usec
+	BL libc_usleep(SB)
+	RET
+
+TEXT ·publicationBarrier(SB),NOSPLIT|NOFRAME,$0-0
+	B	runtime·armPublicationBarrier(SB)
+
+TEXT runtime·sysctl_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 miblen
+	MOVW	8(R0), R2	// arg 3 out
+	MOVW	12(R0), R3	// arg 4 size
+	MOVW	16(R0), R4	// arg 5 dst
+	MOVW	20(R0), R5	// arg 6 ndst
+	MOVW	0(R0), R0	// arg 1 mib
+	// The arm32 C ABI passes only R0-R3 in registers, so args 5 and 6 must
+	// go on the stack, with arg 5 at the *lowest* address.
+	//
+	// Two things were wrong here and both made getPageSize() fail (the
+	// runtime then died with "failed to get system page size",
+	// 2026-11-17):
+	//   * MOVM.DB.W [R4-R5] stores R5 at sp+0 and R4 at sp+4, i.e. the
+	//     two arguments were swapped;
+	//   * the stack must be 8-byte aligned at the call.  The prologue's
+	//     "str lr,[sp,#-4]!" left SP at 4 mod 8, and a 16-byte SUB keeps
+	//     that parity, so libc was entered misaligned.
+	// The prologue pushed LR (4 bytes), so a 4-mod-8 frame size brings SP
+	// back to an 8-byte boundary at the call: 20 bytes is two argument
+	// words plus the alignment fixup.
+	SUB	$20, R13
+	MOVW	R4, 0(R13)	// arg 5: newp
+	MOVW	R5, 4(R13)	// arg 6: newlen
+	BL	libc_sysctl(SB)
+	ADD	$20, R13
+	RET
+
+TEXT runtime·kqueue_trampoline(SB),NOSPLIT,$0
+	BL	libc_kqueue(SB)
+	RET
+
+// int32 runtime·kevent(int kq, Kevent *changelist, int nchanges, Kevent *eventlist, int events, Timespec *timeout)
+TEXT runtime·kevent_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 keventss
+	MOVW	8(R0), R2	// arg 3 nch
+	MOVW	12(R0), R3	// arg 4 ev
+	MOVW	16(R0), R4	// arg 5 nev
+	MOVW	20(R0), R5	// arg 6 ts
+	MOVW	0(R0), R0	// arg 1 kq
+	// Only R0-R3 are used for arguments, the rest go on the stack, with
+	// arg 5 at the lowest address.  See sysctl_trampoline for why the
+	// former "MOVM.DB.W [R4-R5]" was wrong (it swapped them) and why the
+	// frame is padded to keep SP 8-byte aligned.
+	SUB	$20, R13
+	MOVW	R4, 0(R13)	// arg 5: nev
+	MOVW	R5, 4(R13)	// arg 6: ts
+	BL	libc_kevent(SB)
+	ADD	$20, R13
+	MOVW	$-1, R2
+	CMP	R0, R2
+	BNE	ok
+	BL	libc_error(SB)
+	MOVW	(R0), R0	// errno
+	RSB	$0, R0, R0	// caller wants it as a negative error code
+ok:
+	RET
+
+TEXT runtime·fcntl_trampoline(SB),NOSPLIT,$0
+	// BUGFIX 2026-11-19: the arm64 original stores the result back into
+	// the args struct (ret@12, errno@16); the arm32 rewrite just BL'd and
+	// RET'd, so runtime.fcntl always returned 0 -- poll.OpenDir's
+	// F_DUPFD_CLOEXEC dup came back as fd 0 (stdin) and fdopendir(0)
+	// failed with ENOTDIR, which is what broke every go toolchain
+	// directory walk on the device.
+	MOVW	R0, R4		// &args (libc preserves r4)
+	MOVW	4(R4), R1	// arg 2 cmd
+	MOVW	8(R4), R2	// arg 3 arg
+	MOVW	0(R4), R0	// arg 1 fd
+	BL	libc_fcntl(SB)
+	MOVW	$0, R1
+	MOVW	$-1, R2
+	CMP	R0, R2
+	BNE	noerr
+	BL	libc_error(SB)
+	MOVW	(R0), R1
+	MOVW	$-1, R0
+noerr:
+	MOVW	R0, 12(R4)	// args.ret
+	MOVW	R1, 16(R4)	// args.errno
+	RET
+
+// sigaltstack(const stack_t *ss, stack_t *oss).
+//
+// Runs the real libc call: Go 1.14 could only build darwin/arm with cgo,
+// so its cgo-side startup installed the alternate signal stack and this
+// stub just exited with a marker status.  The revived pure-Go port has no
+// cgo init path, and minitSignalStack() calls this on every new m -- so
+// exiting here killed the process with status 43 during mstart1, before
+// runtime.main ever ran (diagnosed 2026-11-17).
+TEXT runtime·sigaltstack_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 old
+	MOVW	0(R0), R0	// arg 1 new
+	BL	libc_sigaltstack(SB)
+	RET
+
+// Thread related functions.
+//
+// Go 1.14's darwin/arm port always linked with cgo, so its C startup code
+// created threads and these entry points only had to exit with a marker
+// status.  The revived port is pure Go, so they must perform the real
+// libc calls -- each one that exited instead killed the process during
+// runtime startup (status 43/44/45/46/47/48; diagnosed 2026-11-17).
+
+// mstart_stub is the entry point pthread_create starts a new thread at.
+// R0 points to the m; we are already on that m's g0 stack.
+//
+// This must follow the C ABI (pthread calls it) and set up the g register
+// before entering Go code, mirroring darwin/arm64's mstart_stub.
+TEXT runtime·mstart_stub(SB),NOSPLIT,$32
+	// Save callee-save registers (R4-R11) = 32 bytes, keeping SP 8-aligned.
+	MOVM.DB.W	[R4-R11], (R13)
+
+	// g = m.g0 (R0 still holds *m; MOVM does not touch it)
+	MOVW	m_g0(R0), g
+	BL	runtime·save_g(SB)
+
+	BL	runtime·mstart(SB)
+
+	// Restore callee-save registers.
+	MOVM.IA.W	(R13), [R4-R11]
+
+	// The pthread is detached, so this value is discarded.
+	MOVW	$0, R0
+	RET
+
+TEXT runtime·pthread_attr_init_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 attr
+	BL	libc_pthread_attr_init(SB)
+	RET
+
+TEXT runtime·pthread_attr_getstacksize_trampoline(SB),NOSPLIT,$0
+	// Go's block is {attr@0, size@4} (see pthread_create_trampoline).
+	MOVW	4(R0), R1	// arg 2 size
+	MOVW	0(R0), R0	// arg 1 attr
+	BL	libc_pthread_attr_getstacksize(SB)
+	RET
+
+TEXT runtime·pthread_attr_setdetachstate_trampoline(SB),NOSPLIT,$0
+	// Go's block is {attr@0, state@4}.
+	MOVW	4(R0), R1	// arg 2 state
+	MOVW	0(R0), R0	// arg 1 attr
+	BL	libc_pthread_attr_setdetachstate(SB)
+	RET
+
+TEXT runtime·pthread_create_trampoline(SB),NOSPLIT,$0
+	// The prologue's "str lr,[sp,#-4]!" leaves SP at 4 mod 8, so the
+	// scratch frame must be a 4-mod-8 size to hand libc an 8-byte
+	// aligned stack (12 = one word for the discarded thread id plus the
+	// alignment fixup).  With 8 the call was rejected with EINVAL.
+	SUB	$12, R13
+	// Go declares this as pthread_create(attr, start, arg) with
+	// //go:cgo_unsafe_args and passes &attr, so the argument block is
+	// {attr@0, start@4, arg@8}.  Reading from +4 shifted every argument
+	// by one word, and libc then saw mstart_stub's address as the attr
+	// pointer -- its "ADHT" signature check failed and pthread_create
+	// returned EINVAL (diagnosed 2026-11-17).
+	MOVW	0(R0), R1	// arg 2 attr
+	MOVW	4(R0), R2	// arg 3 start
+	MOVW	8(R0), R3	// arg 4 arg
+	MOVW	R13, R0		// arg 1 &threadid (discarded)
+	BL	libc_pthread_create(SB)
+	ADD	$12, R13
+	RET
+
+TEXT runtime·raise_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 sig
+	BL	libc_raise(SB)
+	RET
+
+TEXT runtime·pthread_mutex_init_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 attr
+	MOVW	0(R0), R0	// arg 1 mutex
+	BL	libc_pthread_mutex_init(SB)
+	RET
+
+TEXT runtime·pthread_mutex_lock_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 mutex
+	BL	libc_pthread_mutex_lock(SB)
+	RET
+
+TEXT runtime·pthread_mutex_unlock_trampoline(SB),NOSPLIT,$0
+	MOVW	0(R0), R0	// arg 1 mutex
+	BL	libc_pthread_mutex_unlock(SB)
+	RET
+
+TEXT runtime·pthread_cond_init_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 attr
+	MOVW	0(R0), R0	// arg 1 cond
