+	MOVW	4(R0), R2	// size
+	MOVW	0(R0), R1	// address
+	BL	libc_mach_vm_region(SB)
+	ADD	$16, R13	// pop info/pad + count + objname
+	MOVW.P	4(R13), R2	// pop struct ptr
+	MOVW	R0, 24(R2)	// save r1
+	RET
