@@ -0,0 +1,23 @@
+// Copyright 2014 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+// iOS 10.3.3 has no procfs, so the auxv-based HWCap probe used on
+// linux/arm cannot run here.  Every device this port targets (A6X)
+// has VFPv3, and the toolchain refuses to build for GOARM<7 anyway
+// (ld64/macho32 plus the hard-float ABI both assume it), so the
+// check is a fixed GOARM gate rather than a runtime capability probe.
+func checkgoarm() {
+	if goarm < 7 {
+		print("runtime: darwin/arm requires GOARM=7 (iOS armv7 is hard-float)\n")
+		exit(1)
+	}
+}
+
+//go:nosplit
+func cputicks() int64 {
+	// runtime·nanotime() is a poor approximation of CPU ticks that is enough for the profiler.
+	return nanotime()
+}
