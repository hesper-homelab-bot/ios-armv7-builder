+// syscall calls a function in libc on behalf of the syscall package.
+// syscall takes a pointer to a struct like:
+// struct {
+//	fn    uintptr
+//	a1    uintptr
+//	a2    uintptr
+//	a3    uintptr
+//	r1    uintptr
+//	r2    uintptr
+//	err   uintptr
+// }
+// syscall must be called on the g0 stack with the
+// C calling convention (use libcCall).
+
+// ==== darwin/arm additions for the Go 1.27 port (2026-11-16) ====
+// Trampolines that upstream added after darwin/arm was dropped, adapted
+// from sys_darwin_arm64.s to the arm32 Darwin libc ABI:
+//   args 1-4 in R0-R3, args 5+ on the stack (8-byte aligned),
+//   return in R0 (R0:R1 for 64-bit), errno via libc_error.
+// The 1.14 bodies above are kept verbatim: they were proven on exactly
+// this OS/arch (iOS 10.3.3, armv7).
+
+TEXT runtime·arc4random_buf_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 nbytes
+	MOVW	0(R0), R0	// arg 1 buf
+	BL	libc_arc4random_buf(SB)
+	RET
+
+TEXT runtime·issetugid_trampoline(SB),NOSPLIT,$0
+	BL	libc_issetugid(SB)
+	RET
+
+TEXT runtime·mlock_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 len
+	MOVW	0(R0), R0	// arg 1 addr
+	BL	libc_mlock(SB)
+	RET
+
+TEXT runtime·osinit_hack_trampoline(SB),NOSPLIT,$0
+	// notify_is_valid_token(0) faults on iOS 10.3.3 -- libSystem
+	// dereferences the null token (observed 2026-11-17: EXC_BAD_ACCESS
+	// in the shared cache with r0 == 0), so the arm32 trampoline skips it.
+	// xpc_date_create_from_current() is the call that actually performs the
+	// early libc initialisation we depend on (and the one the upstream
+	// comment credits with fixing the fork/exec hangs), so keep it.
+	BL	libc_xpc_date_create_from_current(SB)
+	RET
+
+TEXT runtime·proc_regionfilename_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// address
+	MOVW	8(R0), R2	// buffer
+	MOVW	12(R0), R3	// buffer_size
+	MOVW	0(R0), R0	// pid
+	BL	libc_proc_regionfilename(SB)
+	RET
+
+TEXT runtime·pthread_key_create_trampoline(SB),NOSPLIT,$0
+	MOVW	4(R0), R1	// arg 2 destructor
+	MOVW	0(R0), R0	// arg 1 *key
+	BL	libc_pthread_key_create(SB)
+	RET
+
+TEXT runtime·sysctlbyname_trampoline(SB),NOSPLIT,$0
+	// sysctlbyname(name, oldp, oldlenp, newp, newlen) -- 5 args:
+	// r0-r3 + newlen on the stack (padded to 8 bytes).
+	MOVW.W	R0, -4(R13)	// push struct ptr
+	MOVW	16(R0), R1	// newlen
+	MOVW.W	R1, -8(R13)	// push newlen + 1 pad word (keeps 8-alignment)
+	MOVW	12(R0), R3	// newp
+	MOVW	8(R0), R2	// oldlenp
+	MOVW	4(R0), R1	// oldp
+	MOVW	0(R0), R0	// name
+	BL	libc_sysctlbyname(SB)
+	ADD	$8, R13		// pop newlen + pad
+	MOVW.P	4(R13), R2	// pop struct ptr
+	MOVW	R0, 20(R2)	// save r1 (err slot in Go-side struct)
+	RET
+
+TEXT runtime·mach_vm_region_trampoline(SB),NOSPLIT,$0
+	// mach_vm_region(task, *address, *size, flavor, info, *count, *objname)
+	// 7 args: r0-r3 + info/count/objname on the stack (padded to 8).
+	MOVW.W	R0, -4(R13)	// push struct ptr
+	MOVW	20(R0), R1	// object_name
+	MOVW.W	R1, -4(R13)
+	MOVW	16(R0), R1	// count
+	MOVW.W	R1, -4(R13)
+	MOVW	12(R0), R1	// info
+	MOVW.W	R1, -8(R13)	// push info + 1 pad (8-align)
+	BL	libc_mach_task_self_(SB)	// mach_task_self(); BL (not MOVW $addr) so the
+						// linker routes it through the PLT/GOT: an in-place
+						// bind inside __TEXT is rejected by the iOS 10 dyld
+						// ("segment 1 is not writable", tailcat 2026-11-17).
