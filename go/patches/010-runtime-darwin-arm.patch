 	if ret >= 0 && int32(out) > 0 {
 		return uintptr(out)
 	}
+	// darwin/arm (revived port): sysctl returns EINVAL when called this
+	// early on iOS 10.3.3, even though the argument sequence matches what
+	// clang generates for the identical call (verified with cc-wrapper -S)
+	// and errno reads back as 22.  Leaving physPageSize at 0 makes malloc
+	// throw "failed to get system page size", so fall back to the value a
+	// C probe measures on the target:
+	//
+	//	$ probe-sysctl          # on the device
+	//	sysctl(hw.pagesize) ret=0 out=4096 nout=4
+	//
+	// armv7 iOS only ever runs a 4 KiB kernel page size, so the constant is
+	// safe; a future fix can retry sysctl once libSystem is further along.
+	if GOOS == "darwin" && goarch.GOARCH == "arm" {
+		return 4096
+	}
 	return 0
 }
 
