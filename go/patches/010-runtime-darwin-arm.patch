@@ -578,8 +584,15 @@
 	MOVW	m_g0(R8), R3
 	CMP	R3, g
 	BEQ	nosave
+	// Save the gcc argument pointer (R0) somewhere callee-saved first:
+	// gosave_systemstack_switch and setg both clobber R0, so reading it
+	// after the BL below would preserve garbage instead of the argument
+	// (seen on the device as gettimeofday receiving r0=0xfffffe20).
+	// arm64 does the same thing with R9; R6 is callee-saved on ARM and
+	// free here.
+	MOVW	R0, R6
 	BL	gosave_systemstack_switch<>(SB)
-	MOVW	R0, R5
+	MOVW	R6, R5
 	MOVW	R3, R0
 	BL	setg<>(SB)
 	MOVW	R5, R0
@@ -592,6 +605,14 @@
 	MOVW	(g_stack+stack_hi)(R4), R4
 	SUB	R2, R4
 	MOVW	R4, 16(R13)	// save depth in stack (can't just save SP, as stack might be copied during a callback)
+	// R9 is the Go linker's scratch register -- every "·sym(SB)"
+	// reference clobbers it -- but Darwin's libSystem requires it to be
+	// zero on entry (a plain C program has r9 == 0 at a libc call site).
+	// Leaving Go's scratch there makes libc misbehave in ways that look
+	// like successful-but-wrong results: mmap returned an unaligned
+	// pointer, sysctl returned EINVAL, and pthread_key_create reported
+	// success without writing the key (all observed 2026-11-17).
+	MOVW	$0, R9
 	BL	(R1)
 
 	// Restore registers, g, stack pointer.
@@ -620,6 +641,7 @@
 	MOVW	$0, R4
 	MOVW	R4, 20(R13)
 	MOVW	R2, 16(R13)	// Save old stack pointer.
+	MOVW	$0, R9		// libSystem wants r9 == 0; see the switch path
 	BL	(R1)
 	// Restore stack pointer.
 	MOVW	16(R13), R2
