<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hesper.dropbear</string>

	<!-- Runs as root so that the server can drop to the connecting user's
	     privileges after authentication, the same as /usr/sbin/sshd does.
	     The bootstrap locates the wrapper next to the users' own scripts. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/var/mobile/.local/bin/dropbear-daemon.sh</string>
	</array>

	<!-- Primary port, plus a fallback kept alongside it.  Dropbear listens on
	     every -p it is given, so the fallback is passed straight through to
	     the binary as a second -p: if the primary port regresses, the 2222
	     lifeline -- the one port that was verified working end to end --
	     still accepts connections.
	     Set DROPBEAR_EXTRA_ARGS to empty for a single-port installation. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>DROPBEAR_PORT</key>
		<string>__DROPBEAR_PORT__</string>
		<key>DROPBEAR_EXTRA_ARGS</key>
		<string>__DROPBEAR_EXTRA_ARGS__</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>StandardErrorPath</key>
	<string>/var/mobile/.local/dropbear-daemon.err</string>
	<key>StandardOutPath</key>
	<string>/var/mobile/.local/dropbear-daemon.log</string>
</dict>
</plist>
