<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hesper.osshd</string>

	<!-- THIRD daemon on its own port, not a replacement for anything:

	       port 22    dropbear (primary remote access)
	       port 22222 /usr/sbin/sshd, OpenSSH 6.7p1, protected by sshfix
	       port 22226 this one -- the cross-built OpenSSH 10.6p2

	     Keeping the new build on its own port means it can be exercised over
	     real connections while both working access paths stay untouched.
	     If you ever want to retire a daemon, remove it from here and nowhere
	     else: the plists are the only thing that starts them. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/var/mobile/.local/bin/osshd-daemon.sh</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>StandardErrorPath</key>
	<string>/var/mobile/.local/osshd.err</string>
	<key>StandardOutPath</key>
	<string>/var/mobile/.local/osshd.log</string>
</dict>
</plist>
