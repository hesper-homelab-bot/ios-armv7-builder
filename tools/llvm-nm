#!/bin/bash
# Resolve an llvm-nm binary across host llvm version spreads (CI runners and
# dev boxes carry different releases; the -NN suffix is not guaranteed).
for c in llvm-nm-21 llvm-nm-20 llvm-nm-19 llvm-nm-18 llvm-nm-17 llvm-nm-16 llvm-nm; do
    command -v "$c" >/dev/null 2>&1 && { exec "$c" "$@"; }
done
echo "llvm-nm not found (install llvm)" >&2
exit 127
