#!/bin/sh
AR="${LLVM_AR:-}"
if [ -z "$AR" ]; then
    for c in llvm-ar llvm-ar-21 llvm-ar-20 llvm-ar-19 llvm-ar-18 \
             /usr/lib/llvm-*/bin/llvm-ar; do
        command -v "$c" >/dev/null 2>&1 && AR="$c" && break
        [ -x "$c" ] && AR="$c" && break
    done
fi
[ -n "$AR" ] || { echo "darwin-ranlib: llvm-ar not found; set LLVM_AR" >&2; exit 127; }
exec "$AR" --format=darwin s "$@"
